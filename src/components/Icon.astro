const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' as const };
const brand = name in brandIcons ? brandIcons[name as keyof typeof brandIcons] : null;
const strokes = brand ? [] : strokeIcons[name as keyof typeof strokeIcons];
---

{
  brand ? (
    <svg class={className} viewBox={brand.viewBox} fill="currentColor" focusable="false" {...a11y}>
      <path d={brand.d} />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
      {...a11y}
    >
      {strokes.map((d) => <path d={d} />)}
    </svg>
  )
}
