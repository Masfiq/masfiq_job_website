---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { showcase, site } from '../data/content';
import { projectId } from '../lib/slug';
import { newTab, newTabHint } from '../lib/links';
import { getImage } from '../lib/images';

const photo = getImage(site.photo);

// Number shown before the count up animation runs (and when it cannot).
const formatStat = (value: number, decimals = 0) =>
  value.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true">
    <span class="blob blob--blue" data-blob></span>
    <span class="blob blob--teal" data-blob></span>
    <span class="blob blob--violet" data-blob></span>
    <span class="blob blob--amber" data-blob></span>
  </div>
  <!-- Dot grid that ripples like the anime.js homepage; filled in by motion.ts -->
  <div class="dotgrid" data-dotgrid aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      {
        photo && (
          <Image
            class="hero__photo"
            src={photo}
            alt={`Photo of ${site.name}`}
            width={176}
            height={176}
            densities={[1, 2]}
            loading="eager"
            data-hero
          />
        )
      }
      <p class="hero__role" data-hero>{site.headline}</p>
      <h1 id="hero-title" class="hero__title" data-hero-title>{site.name}</h1>
      <p class="hero__summary" data-hero-soft>{site.summary}</p>

      <div class="hero__actions" data-hero>
        <a class="btn btn--filled" href="#projects">
          View Projects
          <Icon name="arrow-down" />
        </a>
        <a class="btn btn--blue" href={site.resume} {...newTab}>
          <Icon name="download" />
          Download Resume
          <span class="sr-only">{newTabHint}</span>
        </a>
        <a class="btn btn--outlined tone-violet" href={site.github} {...newTab}>
          <Icon name="github" />
          GitHub
          <span class="sr-only">{newTabHint}</span>
        </a>
      </div>

      <ul class="hero__links" data-hero>
        <li>
          <a class="tone-blue" href={site.linkedin} {...newTab}>
            <Icon name="linkedin" />
            LinkedIn
            <span class="sr-only">{newTabHint}</span>
          </a>
        </li>
        <li>
          <a class="tone-teal" href={site.scholar} {...newTab}>
            <Icon name="scholar" />
            Google Scholar
            <span class="sr-only">{newTabHint}</span>
          </a>
        </li>
        <li>
          <a class="tone-red" href={`mailto:${site.email}`}>
            <Icon name="mail" />
            {site.email}
          </a>
        </li>
      </ul>
    </div>

    <div
      class="pipeline"
      data-pipeline
      data-showcase
      role="region"
      aria-roledescription="carousel"
      aria-label="Featured projects"
    >
      <div class="pipeline__slides">
        {
          showcase.map((slide, si) => (
            <div
              class:list={['pipeline__slide', `tone-${slide.stats[0].tone}`, { 'is-active': si === 0 }]}
              data-slide
              role="group"
              aria-roledescription="slide"
              aria-label={`${si + 1} of ${showcase.length}: ${slide.project}`}
              inert={si !== 0}
            >
              <div class="pipeline__head">
                <span class="pipeline__dots" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                </span>
                <span class="pipeline__title">{slide.project}</span>
                <a class="pipeline__more" href={`#${projectId(slide.project)}`}>
                  Details
                  <span class="sr-only">: {slide.project}</span>
                  <Icon name="arrow-down" />
                </a>
              </div>

              <ol class="pipeline__steps">
                {slide.steps.map((step, i) => (
                  <li class={`pipeline__step tone-${step.tone}`} data-step>
                    <span class="pipeline__label">{step.label}</span>
                    <span class="pipeline__dot" aria-hidden="true" />
                    {i < slide.steps.length - 1 && <span class="pipeline__line" aria-hidden="true" />}
                    <span class="pipeline__body">
                      <span class:list={['pipeline__text', { pipeline__check: step.check }]}>
                        {step.check && <Icon name="check" />}
                        {step.text}
                      </span>
                      {step.chips && (
                        <span class="pipeline__chips">
                          {step.chips.map((c) => (
                            <span class={`tag tone-${c.tone}`}>{c.name}</span>
                          ))}
                        </span>
                      )}
                    </span>
                  </li>
                ))}
              </ol>

              <div class="pipeline__stats">
                {slide.stats.map((s) => (
                  <div class={`tone-${s.tone}`} data-stat>
                    <span class="pipeline__num">
                      {s.prefix}
                      <span data-count={s.value} data-decimals={s.decimals ?? 0}>
                        {formatStat(s.value, s.decimals)}
                      </span>
                      {s.suffix}
                    </span>
                    <span class="pipeline__unit">{s.unit}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Slider controls. Hidden until the script is ready, since they need it to work. -->
      <div class="pipeline__nav">
        <button class="pipeline__pause" type="button" data-pause aria-label="Pause the project slideshow">
          <Icon name="pause" class="pipeline__icon-pause" />
          <Icon name="play" class="pipeline__icon-play" />
        </button>
        <div class="pipeline__pills">
          {
            showcase.map((slide, si) => (
              <button
                class={`pipeline__pill tone-${slide.stats[0].tone}`}
                type="button"
                data-pill
                aria-label={`Show project ${si + 1}: ${slide.project}`}
                aria-current={si === 0 ? 'true' : undefined}
              >
                <span class="pipeline__fill" />
              </button>
            ))
          }
        </div>
        <span class="pipeline__count" data-count-label aria-hidden="true">1 / {showcase.length}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 8vw, 112px) clamp(64px, 9vw, 128px);
  }

  /* Soft colored light behind the hero */
  .hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.5;
    will-change: transform;
  }

  .blob--blue {
    top: -12%;
    right: 4%;
    width: 520px;
    height: 520px;
    background: #c6dafc;
  }

  .blob--teal {
    top: 30%;
    right: 30%;
    width: 360px;
    height: 360px;
    background: #b2dfdb;
  }

  .blob--violet {
    bottom: -20%;
    right: -6%;
    width: 440px;
    height: 440px;
    background: #e4cffa;
  }

  .blob--amber {
    bottom: -14%;
    left: -8%;
    width: 380px;
    height: 380px;
    background: #fde2c4;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .hero__photo {
    width: 88px;
    height: 88px;
    margin-bottom: 20px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #ffffff;
    box-shadow:
      0 0 0 3px var(--blue),
      var(--shadow-2);
  }

  .hero__role {
    display: inline-block;
    padding: 6px 14px;
    border-radius: var(--pill);
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--border);
    color: var(--teal-ink);
    font-size: clamp(0.875rem, 1.4vw, 1rem);
    font-weight: 500;
  }

  .hero__title {
    margin-top: 20px;
    padding-bottom: 0.08em;
    background: linear-gradient(90deg, var(--teal-ink), var(--blue) 40%, var(--violet-ink) 70%, var(--teal-ink));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: var(--teal-ink);
    -webkit-text-fill-color: transparent;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero__summary {
    max-width: 36ch;
    margin-top: 20px;
    color: var(--text-2);
    font-size: clamp(1.1875rem, 2.1vw, 1.5rem);
    line-height: 1.45;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__actions .btn--outlined {
    background: rgba(255, 255, 255, 0.7);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 28px;
    list-style: none;
  }

  .hero__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--text-2);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .hero__links a:hover {
    color: var(--c-ink);
    text-decoration: underline;
  }

  .hero__links :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--c);
  }

  /* Pipeline diagram card */
  .pipeline {
    margin: 0;
    padding: clamp(20px, 3vw, 28px);
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-3);
  }

  .pipeline__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-weight: 500;
  }

/* Slider: slides share one grid cell so the card keeps the height of the tallest slide */
  .pipeline__slides {
    display: grid;
  }

  .pipeline__slide {
    grid-area: 1 / 1;
    min-width: 0;
    margin: 0;
  }

  .pipeline__slide:not(.is-active) {
    visibility: hidden;
  }

  .pipeline__title {
    flex: 1;
    min-width: 0;
  }

  .pipeline__more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: var(--pill);
    background: var(--c-tint);
    color: var(--c-ink);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .pipeline__more:hover {
    color: var(--c-ink);
    text-decoration: underline;
  }

  .pipeline__more :global(svg) {
    width: 14px;
    height: 14px;
  }

  .pipeline__nav {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    visibility: hidden;
  }

  .pipeline:global(.is-ready) .pipeline__nav {
    visibility: visible;
  }

  .pipeline__pause {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: #ffffff;
    color: var(--text-2);
    cursor: pointer;
  }

  .pipeline:not(:global(.is-auto)) .pipeline__pause {
    display: none;
  }

  .pipeline__pause:hover {
    background: var(--blue-tint);
    color: var(--blue-ink);
  }

  .pipeline__pause :global(svg) {
    width: 14px;
    height: 14px;
  }

  .pipeline__pause :global(.pipeline__icon-play),
  .pipeline:global(.is-paused) .pipeline__pause :global(.pipeline__icon-pause) {
    display: none;
  }

  .pipeline:global(.is-paused) .pipeline__pause :global(.pipeline__icon-play) {
    display: block;
  }

  .pipeline__pills {
    display: flex;
    align-items: center;
    flex: 1;
  }

  /* Each pill is a 24px tall button; the visible bar is drawn inside it */
  .pipeline__pill {
    position: relative;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: width 0.35s var(--ease);
  }

  .pipeline__pill::before,
  .pipeline__fill {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    height: 8px;
    border-radius: var(--pill);
  }

  .pipeline__pill::before {
    content: '';
    background: var(--border-strong);
  }

  .pipeline__fill {
    background: var(--c);
    transform: scaleX(0);
    transform-origin: left;
  }

  .pipeline__pill[aria-current] {
    width: 56px;
  }

  .pipeline__pill[aria-current]::before {
    left: 4px;
    right: 4px;
    background: var(--c-tint);
  }

  .pipeline__pill[aria-current] .pipeline__fill {
    left: 4px;
    right: 4px;
  }

  /* Without autoplay (reduced motion), the current pill is simply filled */
  .pipeline:not(:global(.is-auto)) .pipeline__pill[aria-current] .pipeline__fill {
    transform: scaleX(1);
  }

  .pipeline__count {
    color: var(--text-3);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .pipeline__dots {
    display: inline-flex;
    gap: 6px;
  }

  .pipeline__dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .pipeline__dots span:nth-child(1) {
    background: var(--red);
  }
  .pipeline__dots span:nth-child(2) {
    background: var(--amber);
  }
  .pipeline__dots span:nth-child(3) {
    background: var(--green);
  }

  .pipeline__steps {
    position: relative;
    margin: 0;
    padding: 20px 0 4px;
    list-style: none;
  }

  .pipeline__step {
    --col: 92px;
    --gap: 16px;
    position: relative;
    display: grid;
    grid-template-columns: var(--col) 1fr;
    gap: var(--gap);
    padding-bottom: 20px;
  }

  /* connector line to the next step */
  .pipeline__line {
    position: absolute;
    left: calc(var(--col) + var(--gap) / 2 - 1px);
    top: 12px;
    bottom: -6px;
    width: 2px;
    background: linear-gradient(var(--c), var(--border));
    transform-origin: top;
  }

  .pipeline__dot {
    position: absolute;
    left: calc(var(--col) + var(--gap) / 2 - 6px);
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 4px var(--c-tint);
  }

  .pipeline__label {
    color: var(--c-ink);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.6;
  }

  .pipeline__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 16px;
  }

  .pipeline__text {
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .pipeline__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .pipeline__check {
    display: inline-flex;
    align-items: flex-start;
    gap: 8px;
  }

  .pipeline__check :global(svg) {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    padding: 2px;
    border-radius: 50%;
    background: var(--green);
    color: #ffffff;
    stroke-width: 3;
    flex: none;
  }

  .pipeline__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 4px;
  }

  .pipeline__stats div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px;
    border-radius: 16px;
    background: var(--c-tint);
  }

  .pipeline__num {
    color: var(--c-ink);
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    white-space: nowrap;
  }

  .pipeline__unit {
    color: var(--c-ink);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .pipeline {
      max-width: 560px;
    }

    .blob--teal {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }

    .pipeline__step {
      --col: 74px;
      --gap: 12px;
    }

    .pipeline__label {
      font-size: 0.75rem;
      letter-spacing: 0.02em;
    }

    .pipeline__body {
      padding-left: 12px;
    }

    .pipeline__stats div {
      padding: 12px 10px;
    }

    .pipeline__num {
      font-size: 1.25rem;
    }
  }
</style>
