---
import Base from '../layouts/Base.astro';
import { site } from '../data/content';
---

<Base title={`Page not found | ${site.name}`} noindex>
  <main id="main" class="notfound container">
    <p class="eyebrow">404</p>
    <h1 class="notfound__title">This page does not exist.</h1>
    <p class="notfound__text">The link may be old or mistyped.</p>
    <a class="btn btn--filled" href="/">Back to the home page</a>
  </main>
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    gap: 16px;
  }

  .notfound__title {
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.03em;
  }

  .notfound__text {
    margin-bottom: 16px;
    color: var(--text-2);
    font-size: 1.125rem;
  }
</style>
